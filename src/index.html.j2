{%- set p = c.person -%}
{%- macro arrow() -%}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1 8h13M9 3l5 5-5 5" stroke="currentColor" stroke-width="1.5"/></svg>{%- endmacro -%}
{%- macro plus() -%}<svg viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 0v14M0 7h14" stroke="currentColor" stroke-width="1.4"/></svg>{%- endmacro -%}
{%- macro copyi() -%}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5" y="5" width="9" height="9" stroke="currentColor" stroke-width="1.3"/><path d="M11 5V2H2v9h3" stroke="currentColor" stroke-width="1.3"/></svg>{%- endmacro -%}
{%- macro dl() -%}<svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1v10M3.5 6.5 8 11l4.5-4.5M1 15h14" stroke="currentColor" stroke-width="1.5"/></svg>{%- endmacro -%}
{%- macro ext(cls="") -%}<svg{% if cls %} class="{{ cls }}"{% endif %} viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 2H2v12h12v-4M9 1h6v6M15 1 7 9" stroke="currentColor" stroke-width="1.4"/></svg>{%- endmacro -%}
{%- macro mark(cls="brand-mark") -%}<svg class="{{ cls }}" viewBox="0 0 36 36" aria-hidden="true"><rect x="0.5" y="0.5" width="35" height="35" fill="none" stroke="var(--copper)"/><text x="18" y="23" text-anchor="middle" font-family="Clash Grotesk, Hanken Grotesk, sans-serif" font-weight="600" font-size="16" fill="var(--on-navy)">SN<tspan font-style="italic" fill="var(--copper)">K</tspan></text><path d="M5 30h7v-2h7v-2h7v-2h5" fill="none" stroke="var(--copper)" stroke-width="1"/></svg>{%- endmacro -%}
{%- macro net(cls) -%}<svg class="{{ cls }}" viewBox="0 0 600 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g stroke="var(--copper)" stroke-width="0.6" opacity="0.5" fill="none">{% for e in network.edges %}<path d="M{{ e[0] }} {{ e[1] }}L{{ e[2] }} {{ e[3] }}"/>{% endfor %}</g><g fill="var(--copper)">{% for n in network.nodes %}<circle cx="{{ n[0] }}" cy="{{ n[1] }}" r="{{ n[2] }}" opacity="{{ n[3] }}"/>{% endfor %}</g></svg>{%- endmacro -%}
{%- macro fig(m, cls="num") -%}
{%- if m.from is defined -%}<span class="{{ cls }}" aria-hidden="true"><span class="from">{{ m.from }}</span><span class="arw">→</span><span class="odo" data-from="{{ m.from }}">{{ m.value }}</span><small>{{ m.suffix }}</small></span>
{%- else -%}<span class="{{ cls }}" aria-hidden="true">{% if m.prefix %}<small>{{ m.prefix }}</small>{% endif %}<span class="odo">{{ m.value }}</span>{% if m.suffix %}<small>{{ m.suffix }}</small>{% endif %}</span>{%- endif -%}
<span class="sr-only">{{ aria(m) }}</span>
{%- endmacro -%}
{%- macro aria(m) -%}{% if m.from is defined %}{{ m.from }}% to {{ m.value }}%{% else %}{{ m.prefix }}{{ m.value }}{{ m.suffix }}{% endif %}{%- endmacro -%}
{%- if full %}<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
{%- endif %}
<title>{{ page_title or c.seo.title }}</title>
<meta name="description" content="{{ c.seo.description }}">
<meta name="author" content="{{ p.name }}">
<meta name="theme-color" content="#111C2E">
<meta property="og:type" content="profile">
<meta property="og:title" content="{{ p.name }} · Commercial Leadership across Africa">
<meta property="og:description" content="{{ c.hero.lede }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ p.name }}: Turning market opportunity into measurable growth.">
<meta property="profile:first_name" content="Susan">
<meta property="profile:last_name" content="Kiarie">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ p.name }} · Commercial Leadership across Africa">
<meta name="twitter:description" content="{{ c.hero.lede }}">
<meta name="twitter:image" content="{{ og_image }}">
{%- if c.seo.canonical %}
<link rel="canonical" href="{{ c.seo.canonical }}">
<meta property="og:url" content="{{ c.seo.canonical }}">
{%- endif %}
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="icon" href="assets/favicon-32.png" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Hanken+Grotesk:wght@500;600;700&display=swap">
{%- if full %}
<link rel="preconnect" href="https://api.fontshare.com" crossorigin>
<link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-grotesk@400,500,600,700&display=swap">
{%- endif %}
<script type="application/ld+json">{{ jsonld }}</script>
<style>
{{ css }}
</style>
{%- if full %}
</head>
<body>
{%- endif %}
<a class="skip" href="#main">Skip to content</a>

<header class="nav" id="top">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="{{ p.name }}, back to top">{{ mark() }}<span class="brand-name">{{ p.name }}</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Open menu"><span></span></button>
    <nav class="nav-links" id="nav-links" aria-label="Primary" data-open="false">
      <a href="#about">About</a>
      <a href="#impact">Impact</a>
      <a href="#milestones">Milestones</a>
      <a href="#organisations">Organisations</a>
      <a href="#leadership">Leadership</a>
      {%- if c.insights %}<a href="#insights">Insights</a>{% endif %}
      <a href="#contact">Contact</a>
      <a class="btn btn-solid" href="#contact">Let’s connect</a>
    </nav>
  </div>
</header>

<main id="main">

<!-- Hero: professional identity -->
<section class="hero s-navy grain bg-stage" aria-labelledby="hero-h">
  
  <div class="wrap grid12">
    <div class="hero-copy">
      <p class="kicker">{{ c.hero.eyebrow }}</p>
      <h1 id="hero-h">{% for line in c.hero.headline %}<span class="line"><span{% if loop.index0 == c.hero.accentLine %} class="em"{% endif %}>{{ line }}</span></span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
      <p class="lede">{{ c.hero.lede }}</p>
      <div class="hero-cta">
        <a class="btn btn-solid" href="#impact">{{ c.hero.ctaPrimary }} {{ arrow() }}</a>
        <a class="btn btn-line" href="#contact">{{ c.hero.ctaSecondary }}</a>
      </div>
    </div>
    <figure class="hero-figure">
      <span class="corner tl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
      <div class="portrait">
        {%- if p.portrait %}
        <img src="{{ p.portrait }}" alt="{{ p.portraitAlt }}" width="800" height="1000" fetchpriority="high">
        {%- else %}
        <svg viewBox="0 0 400 500" role="img" aria-label="SNK monogram for {{ p.name }}, with a stepped line marking each career move from 2005 to 2026">
          <defs><pattern id="g" width="50" height="50" patternUnits="userSpaceOnUse"><path d="M50 0H0V50" fill="none" stroke="var(--navy-rule)" stroke-width="0.6"/></pattern></defs>
          <rect width="400" height="500" fill="url(#g)"/>
          <text x="24" y="40" font-family="DM Sans, sans-serif" font-weight="600" font-size="10.5" letter-spacing="1.8" fill="var(--on-navy-3)">NAIROBI · 1°17′S 36°49′E</text>
          <text x="376" y="40" text-anchor="end" font-family="DM Sans, sans-serif" font-weight="600" font-size="10.5" letter-spacing="1.8" fill="var(--on-navy-3)">20+ YRS</text>
          <text x="200" y="262" text-anchor="middle" font-family="Clash Grotesk, Hanken Grotesk, sans-serif" font-weight="600" font-size="168" letter-spacing="-4" fill="var(--on-navy)">SN<tspan font-style="italic" fill="var(--copper)">K</tspan></text>
          {%- set ns = namespace(d="M30 448") %}
          {%- for s in steps %}{% set ns.d = ns.d ~ " H" ~ s.x ~ " V" ~ s.y %}{% endfor %}
          <path class="draw" d="{{ ns.d }} H370" fill="none" stroke="var(--copper)" stroke-width="1.6"/>
          {%- for s in steps %}<circle cx="{{ s.x }}" cy="{{ s.y }}" r="2.6" fill="var(--navy)" stroke="var(--copper)" stroke-width="1.2"/>{% endfor %}
          <text x="30" y="478" font-family="DM Sans, sans-serif" font-weight="600" font-size="10.5" fill="var(--on-navy-3)">2005</text>
          <text x="200" y="478" text-anchor="middle" font-family="DM Sans, sans-serif" font-weight="600" font-size="9.5" letter-spacing="1.6" fill="var(--on-navy-3)">CAREER MOVES</text>
          <text x="370" y="478" text-anchor="end" font-family="DM Sans, sans-serif" font-weight="600" font-size="10.5" fill="var(--on-navy-3)">2026</text>
        </svg>
        {%- endif %}
      </div>
      <figcaption><span>{{ p.name }}</span><span>{{ p.currentEmployer | replace(" Limited", "") }} · {{ p.location }}</span></figcaption>
    </figure>
    <div class="proof">
      {%- for x in c.hero.proof %}<div><b class="odo" data-load>{{ x.v }}</b><span>{{ x.l }}</span></div>{% endfor %}
    </div>
  </div>
</section>

<!-- What I bring -->
<section class="bring s-navy grain bg-panels" id="about" aria-labelledby="about-h">
  <div class="wrap grid12">
    <p class="kicker" style="grid-column:1/-1">{{ c.about.kicker }}</p>
    <h2 class="statement" id="about-h">{{ c.about.statement[0] }}<span class="em">{{ c.about.statement[1] }}</span>{{ c.about.statement[2] }}</h2>
    <div class="bio">{% for para in c.about.paragraphs %}<p>{{ para }}</p>{% endfor %}</div>
    <ul class="pillars">
      {%- for x in c.about.pillars %}<li class="rv"><h3>{{ x.t }}</h3><p>{{ x.p }}</p></li>{% endfor %}
    </ul>
  </div>
</section>

<!-- Executive impact -->
<section class="impact s-navy grain bg-gold" id="impact" aria-labelledby="impact-h">
  {{ net("net") }}
  <div class="wrap grid12">
    <div class="sec-head grid12" style="grid-column:1/-1">
      <p class="kicker">Executive impact</p>
      <h2 class="h2" id="impact-h">{{ c.impactHead.title }}</h2>
      <p class="lede">{{ c.impactHead.lede }}</p>
    </div>
    {%- for m in c.impact.featured %}
    <article class="feat f{{ loop.index }} rv" aria-label="{{ aria(m) }}: {{ m.title }}, {{ m.org }}">
      <span class="meta">{{ m.org }}</span>
      <span class="tilt"><span class="d3" data-tilt>{{ fig(m) }}</span></span>
      {%- if m.from is defined %}<div class="share" aria-hidden="true"><i><b style="width:{{ m.from / 25 * 100 }}%"></b></i><i><b style="width:{{ m.value / 25 * 100 }}%"></b></i></div>{% endif %}
      <h3>{{ m.title }}</h3>
      <p class="cap">{{ m.caption }}</p>
      <p class="ctx">{{ m.context }}</p>
      {%- if loop.first %}<p class="linkline"><i aria-hidden="true"></i><span>{{ c.impact.link }}</span></p>{% endif %}
    </article>
    {%- endfor %}
    <div class="second">
      {%- for m in c.impact.secondary %}
      <article class="rv" aria-label="{{ aria(m) }}: {{ m.title }}, {{ m.org }}">
        <span class="meta">{{ m.org }}</span>
        {{ fig(m, "num2") }}
        <h3>{{ m.title }}</h3>
        <p>{{ m.caption }}</p>
        <p class="ctx">{{ m.context }}</p>
      </article>
      {%- endfor %}
    </div>
    <p class="impact-note">{{ c.impact.note }}</p>
  </div>
</section>

<!-- Commercial milestones -->
<div id="milestones">
<section class="s-navy grain bg-hanging band" aria-labelledby="ms-h">
  <div class="wrap">
    <div class="sec-head grid12">
      <p class="kicker">{{ c.stories.title }}</p>
      <h2 class="h2" id="ms-h">Chapters of building and <span class="em">growing businesses.</span></h2>
      <p class="lede">{{ c.stories.lede }}</p>
    </div>
  </div>
</section>
{%- for f in c.stories.features %}
<section class="story s-navy grain bg-st-{{ f.id }}" id="story-{{ f.id }}" aria-labelledby="st-{{ f.id }}">
  <div class="wrap grid12">

    <div class="head"><span class="n">{{ "%02d" % loop.index }}</span><span class="meta">{{ f.org }}</span><span class="who">{{ f.position }} · {{ f.period }}</span></div>

    {%- if f.layout == 'flow' %}
    <div class="st-text">
      <h3 class="t" id="st-{{ f.id }}">{{ f.title[0] }}<span class="em">{{ f.title[1] }}</span>{{ f.title[2] }}</h3>
      <p class="ctx">{{ f.context }}</p>
      <span class="role-h">Susan’s role</span>
      <ul class="role">{% for x in f.did %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>
    <div class="st-vis rv" aria-label="How the outcomes connect">
      <div class="flow">
        <div class="flow-row"><div class="node"><b>{{ f.flow[0].v }}</b><span>{{ f.flow[0].l }}</span></div><i class="arrow" aria-hidden="true"></i><div class="node hot"><b>{{ f.flow[1].v }}</b><span>{{ f.flow[1].l }}</span></div></div>
        <div class="flow-sep"></div>
        <div class="flow-row"><div class="node"><b>{{ f.flow2[0].v }}</b><span>{{ f.flow2[0].l }}</span></div><i class="arrow" aria-hidden="true"></i><div class="node hot"><b>{{ f.flow2[1].v }}</b><span>{{ f.flow2[1].l }}</span></div></div>
        <div class="flow-extra"><b>{{ f.extra.v }}</b><span>{{ f.extra.l }}</span></div>
      </div>
    </div>

    {%- elif f.layout == 'bars' %}
    <div class="st-text right">
      <h3 class="t" id="st-{{ f.id }}">{{ f.title[0] }}<span class="em">{{ f.title[1] }}</span>{{ f.title[2] }}</h3>
      <p class="ctx">{{ f.context }}</p>
      <span class="role-h">Susan’s role</span>
      <ul class="role">{% for x in f.did %}<li>{{ x }}</li>{% endfor %}</ul>
    </div>

    <div class="st-vis left rv">
      <div class="bars">
        <span class="cap">{{ f.bars.label }}</span>
        <div class="bar-row"><b>{{ f.bars.from }}%</b><div class="track" aria-hidden="true"><i style="width:{{ f.bars.from / 25 * 100 }}%"></i></div></div>
        <div class="bar-row to"><b>{{ f.bars.to }}%</b><div class="track" aria-hidden="true"><i style="width:{{ f.bars.to / 25 * 100 }}%"></i></div></div>
        <ul class="chips" aria-label="Expansion markets">{% for m in f.markets %}<li>{{ m }}</li>{% endfor %}</ul>
        {%- for s in f.stats %}<div class="statline"><b>{{ s.v }}</b><span>{{ s.l }}</span></div>{% endfor %}
      </div>
    </div>
    {%- else %}
    <h3 class="t st-wide-t" id="st-{{ f.id }}">{{ f.title[0] }}<span class="em">{{ f.title[1] }}</span>{{ f.title[2] }}</h3>
    <div class="st-stats rv">{% for s in f.stats %}<div><b>{{ s.v }}</b><span>{{ s.l }}</span></div>{% endfor %}</div>
    <div class="st-cols">
      <p class="ctx">{{ f.context }}</p>
      <div class="rolebox"><span class="role-h">Susan’s role</span><ul class="role">{% for x in f.did %}<li>{{ x }}</li>{% endfor %}</ul></div>
    </div>
    {%- endif %}

    <div class="sig"><span>{% if f.id == 'vodafone' %}Recognition{% else %}Why it matters{% endif %}</span><p>{{ f.significance }}</p></div>
  </div>
</section>
{%- endfor %}
<section class="story s-navy grain bg-stool" aria-label="More milestones">
  <div class="wrap grid12">
    <div class="pair">
      {%- for k in c.stories.compact %}
      <article class="mini rv" id="story-{{ k.id }}">
        <span class="meta">{{ k.org }}</span>
        <span class="who">{{ k.role }} · {{ k.period }}</span>
        <b class="big">{{ k.v }}</b>
        <span class="vl">{{ k.vl }}</span>
        <h3>{{ k.title }}</h3>
        <p class="txt">{{ k.text }}</p>
        {%- if k.split %}<div class="split">{% for s in k.split %}<div><b>{{ s.v }}</b><span>{{ s.l }}</span></div>{% endfor %}</div>{% endif %}
        <p class="sg">{{ k.significance }}</p>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>
</div>

<!-- Regional footprint: sticky map with scrolling role steps -->
<section class="s-navy grain bg-streaks-soft scrolly-sec" id="markets" aria-labelledby="markets-h">
  <div class="wrap">
    <div class="sec-head grid12">
      <p class="kicker">Regional footprint</p>
      <h2 class="h2" id="markets-h">{{ c.regions.stepsTitle.split(',')[0] }}, <span class="em">{{ c.regions.stepsTitle.split(', ')[1] }}</span></h2>
      <p class="lede">{{ c.regions.intro }} Scroll to follow each market entry.</p>
    </div>
    <div class="scrolly">
      <figure class="map-fig">
        <svg viewBox="0 0 {{ map.W }} {{ map.H }}" role="img" aria-labelledby="map-t">
          <title id="map-t">Map of East, Central and Southern Africa highlighting the nine countries in Susan's CV: Kenya, Uganda, Tanzania, Burundi, Mozambique, Zambia, Ethiopia, Sudan and the Central African Republic.</title>
          <defs><pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="6" height="6" fill="var(--navy-2)"/><path d="M0 0V6" stroke="var(--on-navy-2)" stroke-width="1" opacity="0.5"/></pattern></defs>
          <g>{% for ct in map.countries %}<path class="land{% if ct.cat %} c-{{ ct.cat }}{% endif %}" data-name="{{ ct.name }}" d="{{ ct.d }}"/>{% endfor %}</g>
          <g aria-hidden="true">
            {%- for ct in map.countries if ct.cat and ct.cat != 'home' %}<path class="ray" data-to="{{ ct.name }}" d="M{{ map.nairobi[0] }} {{ map.nairobi[1] }} Q{{ (map.nairobi[0] + ct.lx)/2 }} {{ (map.nairobi[1] + ct.ly)/2 - 30 }} {{ ct.lx }} {{ ct.ly }}"/>{% endfor %}
            <circle cx="{{ map.nairobi[0] }}" cy="{{ map.nairobi[1] }}" r="4" fill="var(--on-navy)"/>
            <circle class="pulse" cx="{{ map.nairobi[0] }}" cy="{{ map.nairobi[1] }}" r="9" fill="none" stroke="var(--on-navy)" stroke-width="1"/>
            <text class="ctry" x="{{ map.nairobi[0] + 14 }}" y="{{ map.nairobi[1] + 4 }}">Nairobi</text>
            <g class="city" data-city="Mombasa"><circle cx="{{ map.mombasa[0] }}" cy="{{ map.mombasa[1] }}" r="4" fill="var(--copper)"/><text class="ctry" x="{{ map.mombasa[0] + 10 }}" y="{{ map.mombasa[1] + 14 }}">Mombasa</text></g>
            <g class="city" data-city="Kampala"><circle cx="{{ map.kampala[0] }}" cy="{{ map.kampala[1] }}" r="4" fill="var(--copper)"/><text class="ctry" x="{{ map.kampala[0] - 10 }}" y="{{ map.kampala[1] - 10 }}" text-anchor="end">Kampala</text></g>
            {%- for ct in map.countries if ct.cat %}<text class="ctry{% if ct.cat == 'bid' %} dim{% endif %}" x="{{ ct.lx }}" y="{{ ct.ly }}" text-anchor="middle">{{ ct.label }}</text>{% endfor %}
          </g>
        </svg>
        <figcaption><span class="step-ind" aria-hidden="true">{% for m in c.regions.milestones %}<i></i>{% endfor %}<i></i></span>Shading shows the type of work recorded, not its size. Source: Susan’s CV.</figcaption>
      </figure>
      <ol class="steps">
        {%- for m in c.regions.milestones %}
        <li class="step" data-step="{{ loop.index0 }}" data-hl="{{ m.highlight | join('|') }}"{% if m.city %} data-city="{{ m.city }}"{% endif %}>
          <span class="w">{{ m.when }}</span>
          <h3 class="o">{{ m.org }}</h3>
          <p class="pos">{{ m.position }}</p>
          <p class="what">{{ m.what }}</p>
        </li>
        {%- endfor %}
        <li class="step all" data-step="{{ c.regions.milestones | length }}" data-hl="all">
          <span class="w">All markets</span>
          <h3 class="o">Nine markets, one base in Nairobi.</h3>
          <div class="legend">
            {%- for cat in c.regions.categories %}
            <div class="k-{{ cat.id }}">
              <h4><i></i>{{ cat.label }}</h4>
              {%- for ct in c.regions.countries if ct.cat == cat.id %}
              <button type="button" data-country="{{ ct.name }}"><b>{{ ct.display or ct.name }}</b><span>{{ ct.evidence }}</span></button>
              {%- endfor %}
            </div>
            {%- endfor %}
          </div>
        </li>
      </ol>
    </div>
    <details class="chrono" id="career">
      <summary><div><h3>Full career chronology</h3><span class="sub">{{ c.career | length }} roles, May 2005 to the present. Part-time consultancy roles are marked.</span></div><span class="plus">{{ plus() }}</span></summary>
      <div class="chrono-axis" aria-hidden="true"><span>Dates</span><span>Role</span><span>Organisation</span><div class="trk">{% for y in [2005, 2010, 2015, 2020, 2025] %}<span style="left:{{ (y - 2005) / 22 * 100 }}%">{{ y }}</span>{% endfor %}</div></div>
      {%- for r in c.career %}
      <div class="ch-row">
        <span class="d">{{ r.dates }}</span>
        <span class="t">{{ r.title }}</span>
        <span class="o">{{ r.org }}{% if r.type == 'part' %}<em>Part-time · consultancy</em>{% elif not r.end %}<em>Current role</em>{% endif %}</span>
        <div class="bar" aria-hidden="true"><i class="{% if r.type == 'part' %}part{% elif not r.end %}now{% endif %}" style="left:{{ ((r.start - 2005) / 22 * 100) | round(2) }}%; width:{{ (((r.end or now_year) - r.start) / 22 * 100) | round(2) }}%"></i></div>
      </div>
      {%- endfor %}
      <div class="ch-foot"><div class="key" aria-hidden="true"><span><i></i>Full-time</span><span><i class="part"></i>Part-time / consultancy</span><span><i class="now"></i>Current</span></div><span>Full responsibilities and achievements are in the downloadable CV.</span></div>
    </details>
  </div>
</section>

<!-- Organisations: 3D logo gallery -->
<section class="s-navy grain bg-wall orgs-sec" id="organisations" aria-labelledby="org-h">
  <div class="wrap">
    <div class="sec-head grid12">
      <p class="kicker">Selected organisations</p>
      <h2 class="h2" id="org-h">{{ c.organisations.title }}</h2>
      <p class="lede">{{ c.organisations.lede }}</p>
    </div>
  </div>
  <div class="ring-stage" data-ring>
    <ul class="ring" style="--n: {{ c.organisations['items'] | length }}">
      {%- for o in c.organisations["items"] %}
      <li class="face" style="--i: {{ loop.index0 }}">
        {%- if o.url %}<a class="tile" href="{{ o.url }}" target="_blank" rel="noopener" aria-label="{{ o.name }}, official website (opens in a new tab)">{% else %}<span class="tile" role="img" aria-label="{{ o.name }}">{% endif %}
          {%- if o.logo %}<img src="{{ o.logo }}" alt="" style="height:{{ o.h }}px" draggable="false">{% else %}<span class="wordmark">{{ o.name }}</span>{% endif %}
        {%- if o.url %}</a>{% else %}</span>{% endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
  <div class="wrap ring-ui">
    <div class="ring-ctrl"><button type="button" class="icon-btn" data-ring-prev aria-label="Turn the gallery to the previous logo">←</button><button type="button" class="icon-btn" data-ring-play aria-pressed="false">Pause</button><button type="button" class="icon-btn" data-ring-next aria-label="Turn the gallery to the next logo">→</button></div>
    <p class="disc">{{ c.organisations.disclaimer }}</p>
  </div>
</section>

<!-- Leadership -->
<section class="s-navy grain bg-spots" id="leadership" aria-labelledby="lead-h">
  <div class="wrap grid12">
    <div class="lead-l">
      <p class="kicker">{{ c.leadership.kicker }}</p>
      <h2 class="h2" id="lead-h">{{ c.leadership.title }}</h2>
      <p class="lede">{{ c.leadership.intro }}</p>
      <div class="lead-big rv"><b>{{ c.leadership.stats[0].v }}</b><span>{{ c.leadership.stats[0].l }}</span></div>
    </div>
    <div class="lead-r">
      <div class="lead-stats">{% for s in c.leadership.stats[1:] %}<div><b>{{ s.v }}</b><span>{{ s.l }}</span></div>{% endfor %}</div>
      <ul class="lead-items">{% for i in c.leadership["items"] %}<li><h3>{{ i.h }}</h3><p>{{ i.p }}</p></li>{% endfor %}</ul>
    </div>
  </div>
</section>

<!-- Education -->
<section class="s-navy grain bg-cone" id="education" aria-labelledby="edu-h">
  <div class="wrap grid12">
    <div class="edu-l">
      <p class="kicker">Education</p>
      <h2 class="h2" id="edu-h">{{ c.educationHead.title }}</h2>
      <p class="lede">{{ c.educationHead.lede }}</p>
    </div>
    {%- set mba = c.education[0] %}
    <div class="mba rv">
      <span class="k">Principal qualification</span>
      <span class="big" aria-hidden="true">MBA</span>
      <p class="fld"><span class="sr-only">Master of Business Administration, </span>Strategic Management</p>
      <p class="sch"><b>Daystar University</b><span>{{ mba.date }}</span></p>
    </div>
    <ol class="creds" aria-label="Further qualifications">
      {%- for e in c.education[1:] %}<li><span class="y">{{ e.date }}</span><p class="a">{{ e.award }}</p><p class="s">{{ e.school }}</p></li>{% endfor %}
    </ol>
    <p class="creds-x">Also: {% for e in c.educationExtra %}{{ e.award }}{% if e.school %}, {{ e.school }}{% endif %} ({{ e.date }}){% if not loop.last %} · {% endif %}{% endfor %}</p>
  </div>
</section>

{%- if c.insights %}
<section class="s-navy grain bg-spots" id="insights" aria-labelledby="ins-h">
  <div class="wrap grid12">
    <div class="sec-head grid12" style="grid-column:1/-1"><p class="kicker">Insights</p><h2 class="h2" id="ins-h">Articles, interviews and commentary.</h2></div>
    <div class="ins">{% for i in c.insights %}<a href="{{ i.url }}" target="_blank" rel="noopener"><span class="m">{{ i.type }} · {{ i.outlet }} · {{ i.date }}</span><h3>{{ i.title }}</h3><p>{{ i.summary }}</p></a>{% endfor %}</div>
  </div>
</section>
{%- endif %}

<!-- Contact -->
<section class="contact s-navy grain bg-floor" id="contact" aria-labelledby="contact-h">
  <div class="wrap grid12">
    <p class="kicker" style="grid-column:1/-1">Contact</p>
    <h2 id="contact-h">Let’s build what comes <span class="em">next.</span></h2>
    <div class="contact-l">
      <p>{{ c.contact.lede }}</p>
      <ul class="aud" aria-label="Conversations Susan welcomes">{% for a in c.contact.audiences %}<li>{{ a }}</li>{% endfor %}</ul>
      <div class="contact-cta">
        <a class="btn btn-solid" href="{{ p.cv }}" download="{{ p.cvFilename }}" data-cv data-filename="{{ p.cvFilename }}">Download CV (PDF) {{ dl() }}</a>
        <a class="btn btn-line" href="{{ p.linkedin }}" target="_blank" rel="noopener">LinkedIn profile {{ ext() }}</a>
      </div>
      <p class="status" role="status" aria-live="polite"></p>
    </div>
    <dl class="channels">
      <div class="ch"><dt>Email</dt><dd><a href="mailto:{{ p.email }}">{{ p.email }}</a></dd><span><button class="icon-btn" type="button" data-copy="{{ p.email }}" aria-label="Copy email address">{{ copyi() }}<span>Copy</span></button></span></div>
      <div class="ch"><dt>Telephone</dt><dd><a href="tel:{{ p.phoneHref }}">{{ p.phone }}</a></dd><span><button class="icon-btn" type="button" data-copy="{{ p.phone }}" aria-label="Copy phone number">{{ copyi() }}<span>Copy</span></button></span></div>
      <div class="ch"><dt>LinkedIn</dt><dd><a href="{{ p.linkedin }}" target="_blank" rel="noopener">in/susan-kiarie</a></dd><span><a class="icon-btn" href="{{ p.linkedin }}" target="_blank" rel="noopener" aria-label="Open LinkedIn profile in a new tab">{{ ext() }}</a></span></div>
      <div class="ch"><dt>Based in</dt><dd><span class="v">{{ p.location }}</span></dd><span></span></div>
    </dl>
  </div>
</section>
</main>

<footer class="foot">
  <div class="wrap">
    <div class="who">{{ mark() }}<div><b>{{ p.name }}</b><span>Commercial leader · 20+ years of experience across Africa</span></div></div>
    <nav aria-label="Footer"><a href="{{ p.linkedin }}" target="_blank" rel="noopener">LinkedIn</a><a href="#impact">Impact</a><a href="#career">Career chronology</a><a href="#contact">Contact</a><a href="#top">Back to top</a></nav>
    <small>© <span id="yr">{{ year }}</span> {{ p.name }}</small>
  </div>
</footer>

<script>
{{ js }}
</script>
{%- if full %}
</body>
</html>
{%- endif %}
